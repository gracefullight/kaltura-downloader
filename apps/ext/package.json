{
  "name": "@kaltura-downloader/ext",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "firefox:lint": "npx --yes web-ext@10.6.0 lint --source-dir=dist",
    "firefox:package": "npx --yes web-ext@10.6.0 build --source-dir=dist --artifacts-dir=artifacts/firefox --filename=kaltura-downloader-firefox-{version}.zip --overwrite-dest",
    "build:firefox": "bun run build && bun run firefox:lint && bun run firefox:package",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.38",
    "tsup": "^8.5.1",
    "typescript": "^6.0.2",
    "vitest": "^4.1.1"
  },
  "dependencies": {
    "mux.js": "^6.3.0"
  }
}
