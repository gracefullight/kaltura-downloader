{
  "manifest_version": 3,
  "name": "Kaltura Downloader",
  "version": "1.0.0",
  "description": "Download HLS videos from Kaltura and Hotmart players",
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "kaltura-downloader@gracefullight.dev",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": ["storage", "webRequest"],
  "host_permissions": [
    "*://*.kaltura.com/*",
    "*://*.hotmart.com/*",
    "*://*.jimmyssempte.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.kaf.kaltura.com/*",
        "*://*.hotmart.com/*",
        "*://*.jimmyssempte.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "*://*.kaf.kaltura.com/*",
        "*://*.hotmart.com/*",
        "*://*.jimmyssempte.com/*"
      ],
      "js": ["downloader.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "world": "MAIN"
    }
  ],
  "action": {
    "default_title": "Kaltura Downloader",
    "default_popup": "popup.html"
  }
}
